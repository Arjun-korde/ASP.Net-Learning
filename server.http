Accept: application/json

###

### =========================

### POST - Create User

### =========================

### Create user - valid request

POST {{server_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..N0J6yQMZ9XsJWZ_LswCB2nbgggDOvRwckcB9tGQC260


{
"name": "Rahul",
"email": "rahul@gmail.com"
}

###

### Create another user

POST {{server_HostAddress}}/api/users
Content-Type: application/json

{
"name": "Priya",
"email": "[priya@gmail.com](mailto:priya@gmail.com)"
}

###

### Create user - empty name

POST {{server_HostAddress}}/api/users
Content-Type: application/json

{
"name": "",
"email": "[test@gmail.com](mailto:test@gmail.com)"
}

###

### Create user - empty email

POST {{server_HostAddress}}/api/users
Content-Type: application/json

{
"name": "Test User",
"email": ""
}

###

### Create user - both empty

POST {{server_HostAddress}}/api/users
Content-Type: application/json

{
"name": "",
"email": ""
}

###

